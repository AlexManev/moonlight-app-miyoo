diff --git a/src/joystick/mmiyoo/SDL_joystick_mmiyoo.c b/src/joystick/mmiyoo/SDL_joystick_mmiyoo.c
index e95b19b..78d185e 100644
--- a/src/joystick/mmiyoo/SDL_joystick_mmiyoo.c
+++ b/src/joystick/mmiyoo/SDL_joystick_mmiyoo.c
@@ -29,9 +29,43 @@
 #include "SDL_joystick.h"
 #include "../SDL_sysjoystick.h"
 #include "../SDL_joystick_c.h"
+#include "SDL_hints.h"
+#include "../../video/SDL_sysvideo.h"
+#include "../../video/mmiyoo/SDL_event_mmiyoo.h"
+#include "../../cfg/SDL_moonlightcfg_mmiyoo.h"
+
+extern MOON moon;
+
+/* Virtual joystick layout; the gamepad mapping below turns it into an Xbox style controller */
+enum {
+    MMIYOO_JOY_A,
+    MMIYOO_JOY_B,
+    MMIYOO_JOY_X,
+    MMIYOO_JOY_Y,
+    MMIYOO_JOY_BACK,
+    MMIYOO_JOY_GUIDE,
+    MMIYOO_JOY_START,
+    MMIYOO_JOY_LEFTSHOULDER,
+    MMIYOO_JOY_RIGHTSHOULDER,
+    MMIYOO_JOY_LEFTTRIGGER,
+    MMIYOO_JOY_RIGHTTRIGGER,
+    MMIYOO_JOY_DPUP,
+    MMIYOO_JOY_DPDOWN,
+    MMIYOO_JOY_DPLEFT,
+    MMIYOO_JOY_DPRIGHT,
+    MMIYOO_JOY_NUM_BUTTONS
+};
+
+#define MMIYOO_JOY_AXIS_LEFTX 0
+#define MMIYOO_JOY_AXIS_LEFTY 1
+#define MMIYOO_JOY_NUM_AXES   2
+
+static Uint32 pre_joy_bitmaps = 0;
 
 static int MMIYOO_JoystickInit(void)
 {
+    /* The mmiyoo video driver never sets keyboard focus, which would make SDL drop all joystick events */
+    SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
     return 1;
 }
 
@@ -74,9 +108,11 @@ static SDL_JoystickID MMIYOO_JoystickGetDeviceInstanceID(int device_index)
 
 static int MMIYOO_JoystickOpen(SDL_Joystick *joystick, int device_index)
 {
-    joystick->nbuttons = 14;
-    joystick->naxes = 2;
+    joystick->nbuttons = MMIYOO_JOY_NUM_BUTTONS;
+    joystick->naxes = MMIYOO_JOY_NUM_AXES;
     joystick->nhats = 0;
+    pre_joy_bitmaps = 0;
+    MMIYOO_EventSetGamepadAttached(1);
     return 0;
 }
 
@@ -110,12 +146,71 @@ static int MMIYOO_JoystickSetSensorsEnabled(SDL_Joystick *joystick, SDL_bool ena
     return SDL_Unsupported();
 }
 
+static Uint32 MMIYOO_KeypadToJoystick(Uint32 keypad)
+{
+    /* The Miyoo face buttons are Nintendo style (A right, B bottom). By default they are mapped
+       by position so the bottom button is Xbox A, or by label when useButtonLabels is set. */
+    static const int positional[] = { MYKEY_B, MYKEY_A, MYKEY_Y, MYKEY_X };
+    static const int labeled[] = { MYKEY_A, MYKEY_B, MYKEY_X, MYKEY_Y };
+    const int *face = moon.gamepad.useButtonLabels ? labeled : positional;
+    Uint32 joy = 0;
+    int i;
+
+    for (i = 0; i < 4; i++) {
+        if (keypad & (1 << face[i])) {
+            joy |= (1 << (MMIYOO_JOY_A + i));
+        }
+    }
+
+#define MMIYOO_MAP_KEY(mykey, joybutton) if (keypad & (1 << (mykey))) joy |= (1 << (joybutton))
+    MMIYOO_MAP_KEY(MYKEY_SELECT, MMIYOO_JOY_BACK);
+    MMIYOO_MAP_KEY(MYKEY_MENU, MMIYOO_JOY_GUIDE);
+    MMIYOO_MAP_KEY(MYKEY_START, MMIYOO_JOY_START);
+    MMIYOO_MAP_KEY(MYKEY_L1, MMIYOO_JOY_LEFTSHOULDER);
+    MMIYOO_MAP_KEY(MYKEY_R1, MMIYOO_JOY_RIGHTSHOULDER);
+    MMIYOO_MAP_KEY(MYKEY_L2, MMIYOO_JOY_LEFTTRIGGER);
+    MMIYOO_MAP_KEY(MYKEY_R2, MMIYOO_JOY_RIGHTTRIGGER);
+    if (!moon.gamepad.dpadAsLeftStick) {
+        MMIYOO_MAP_KEY(MYKEY_UP, MMIYOO_JOY_DPUP);
+        MMIYOO_MAP_KEY(MYKEY_DOWN, MMIYOO_JOY_DPDOWN);
+        MMIYOO_MAP_KEY(MYKEY_LEFT, MMIYOO_JOY_DPLEFT);
+        MMIYOO_MAP_KEY(MYKEY_RIGHT, MMIYOO_JOY_DPRIGHT);
+    }
+#undef MMIYOO_MAP_KEY
+
+    return joy;
+}
+
 static void MMIYOO_JoystickUpdate(SDL_Joystick *joystick)
 {
+    Uint32 keypad = MMIYOO_EventGetGamepadBitmaps();
+    Uint32 joy = MMIYOO_KeypadToJoystick(keypad);
+    Uint32 changed = joy ^ pre_joy_bitmaps;
+    Sint16 x = 0, y = 0;
+    int i;
+
+    for (i = 0; i < MMIYOO_JOY_NUM_BUTTONS; i++) {
+        if (changed & (1 << i)) {
+            SDL_PrivateJoystickButton(joystick, i, (joy & (1 << i)) ? SDL_PRESSED : SDL_RELEASED);
+        }
+    }
+    pre_joy_bitmaps = joy;
+
+    if (moon.gamepad.dpadAsLeftStick) {
+        if (keypad & (1 << MYKEY_LEFT)) x -= SDL_JOYSTICK_AXIS_MAX;
+        if (keypad & (1 << MYKEY_RIGHT)) x += SDL_JOYSTICK_AXIS_MAX;
+        if (keypad & (1 << MYKEY_UP)) y -= SDL_JOYSTICK_AXIS_MAX;
+        if (keypad & (1 << MYKEY_DOWN)) y += SDL_JOYSTICK_AXIS_MAX;
+    }
+    /* SDL only emits events when the value actually changes */
+    SDL_PrivateJoystickAxis(joystick, MMIYOO_JOY_AXIS_LEFTX, x);
+    SDL_PrivateJoystickAxis(joystick, MMIYOO_JOY_AXIS_LEFTY, y);
 }
 
 static void MMIYOO_JoystickClose(SDL_Joystick *joystick)
 {
+    pre_joy_bitmaps = 0;
+    MMIYOO_EventSetGamepadAttached(0);
 }
 
 static void MMIYOO_JoystickQuit(void)
@@ -124,7 +219,29 @@ static void MMIYOO_JoystickQuit(void)
 
 static SDL_bool MMIYOO_JoystickGetGamepadMapping(int device_index, SDL_GamepadMapping *out)
 {
-    return SDL_FALSE;
+#define MMIYOO_BUTTON(field, button) out->field.kind = EMappingKind_Button; out->field.target = (button)
+#define MMIYOO_AXIS(field, axis) out->field.kind = EMappingKind_Axis; out->field.target = (axis)
+    MMIYOO_BUTTON(a, MMIYOO_JOY_A);
+    MMIYOO_BUTTON(b, MMIYOO_JOY_B);
+    MMIYOO_BUTTON(x, MMIYOO_JOY_X);
+    MMIYOO_BUTTON(y, MMIYOO_JOY_Y);
+    MMIYOO_BUTTON(back, MMIYOO_JOY_BACK);
+    MMIYOO_BUTTON(guide, MMIYOO_JOY_GUIDE);
+    MMIYOO_BUTTON(start, MMIYOO_JOY_START);
+    MMIYOO_BUTTON(leftshoulder, MMIYOO_JOY_LEFTSHOULDER);
+    MMIYOO_BUTTON(rightshoulder, MMIYOO_JOY_RIGHTSHOULDER);
+    /* L2/R2 are digital, so they are buttons that SDL turns into fully pressed/released triggers */
+    MMIYOO_BUTTON(lefttrigger, MMIYOO_JOY_LEFTTRIGGER);
+    MMIYOO_BUTTON(righttrigger, MMIYOO_JOY_RIGHTTRIGGER);
+    MMIYOO_BUTTON(dpup, MMIYOO_JOY_DPUP);
+    MMIYOO_BUTTON(dpdown, MMIYOO_JOY_DPDOWN);
+    MMIYOO_BUTTON(dpleft, MMIYOO_JOY_DPLEFT);
+    MMIYOO_BUTTON(dpright, MMIYOO_JOY_DPRIGHT);
+    MMIYOO_AXIS(leftx, MMIYOO_JOY_AXIS_LEFTX);
+    MMIYOO_AXIS(lefty, MMIYOO_JOY_AXIS_LEFTY);
+#undef MMIYOO_BUTTON
+#undef MMIYOO_AXIS
+    return SDL_TRUE;
 }
 
 SDL_JoystickDriver SDL_MMIYOO_JoystickDriver = {
diff --git a/src/video/mmiyoo/SDL_event_mmiyoo.c b/src/video/mmiyoo/SDL_event_mmiyoo.c
