+}
+
+void modeToggleGamepad() {
+    keyboardMode = (MMiyooEventInfo.mode == MMIYOO_GAMEPAD_MODE) ? MMIYOO_KEYPAD_MODE : MMIYOO_GAMEPAD_MODE;
+    MMiyooEventInfo.mode = keyboardMode;
+    printf("Mode switched to %s\n", keyboardMode == MMIYOO_GAMEPAD_MODE ? "GAMEPAD" : "KEYPAD");
+}
+
+void MMIYOO_EventSetGamepadAttached(int attached)
+{
+    if (event_sem) {
+        SDL_SemWait(event_sem);
+    }
+
+    gamepadAttached = attached;
+    if (attached && moon.gamepad.enabled) {
+        keyboardMode = MMIYOO_GAMEPAD_MODE;
+    } else if (!attached) {
+        keyboardMode = MMIYOO_KEYPAD_MODE;
+    }
+    if (MMiyooEventInfo.mode != MMIYOO_MOUSE_MODE) {
+        MMiyooEventInfo.mode = keyboardMode;
+    }
+    printf("Gamepad %s, mode is %s\n", attached ? "attached" : "detached",
+           MMiyooEventInfo.mode == MMIYOO_GAMEPAD_MODE ? "GAMEPAD" : "KEYPAD/MOUSE");
+
+    if (event_sem) {
+        SDL_SemPost(event_sem);
+    }
+}
+
+uint32_t MMIYOO_EventGetGamepadBitmaps(void)
+{
+    uint32_t bitmaps = 0;
+
+    if (event_sem) {
+        SDL_SemWait(event_sem);
+    }
+    if (MMiyooEventInfo.mode == MMIYOO_GAMEPAD_MODE) {
+        bitmaps = MMiyooEventInfo.keypad.bitmaps;
+    }
+    if (event_sem) {
+        SDL_SemPost(event_sem);
+    }
+    return bitmaps;
 }
 
 void modeSwitchMouse() {
+    if (MMiyooEventInfo.mode != MMIYOO_MOUSE_MODE) {
+        keyboardMode = MMiyooEventInfo.mode;
+    }
     MMiyooEventInfo.mode = MMIYOO_MOUSE_MODE;
     hotkey = 0;
     hotkeyEnable = 0;
@@ -197,6 +248,9 @@ void MMIYOO_EventInit(void)
     MMiyooEventInfo.mouse.x = 0;
     MMiyooEventInfo.mouse.y = 0;
     MMiyooEventInfo.mode = MMIYOO_KEYPAD_MODE;
+    keyboardMode = MMIYOO_KEYPAD_MODE;
+    pre_mode = MMIYOO_KEYPAD_MODE;
+    gamepadAttached = 0;
 
 #if defined(MMIYOO)
     event_fd = open("/dev/input/event0", O_RDONLY | O_NONBLOCK | O_CLOEXEC);
@@ -321,6 +375,9 @@ int EventUpdate(void *data)
                     } else if (hotkey && (MMiyooEventInfo.keypad.bitmaps & (1 << MYKEY_A))) {
                         modeSwitchMouse();
                         MMiyooEventInfo.keypad.bitmaps &= ~(1 << MYKEY_A);
+                    } else if (hotkey && gamepadAttached && (MMiyooEventInfo.keypad.bitmaps & (1 << MYKEY_X))) { // Keyboard <-> gamepad
+                        modeToggleGamepad();
+                        MMiyooEventInfo.keypad.bitmaps &= ~(1 << MYKEY_X);
                     }
                 }
             }
@@ -355,8 +412,29 @@ void MMIYOO_PumpEvents(_THIS)
     if (!hotkeyEnable) {
         SDL_SendKeyboardKey(SDL_RELEASED, moon.customkey.Select);
     }
