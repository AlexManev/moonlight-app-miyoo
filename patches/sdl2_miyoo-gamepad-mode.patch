+static int gamepadAttached = 0; // set while the app has the Miyoo joystick open (i.e. streaming)
+static int keyboardMode = MMIYOO_KEYPAD_MODE; // mode to return to when leaving mouse mode
+static int pre_mode = MMIYOO_KEYPAD_MODE;
 
