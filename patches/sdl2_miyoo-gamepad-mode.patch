From 382362122b7353449b4e4e147d57ac99ca345684 Mon Sep 17 00:00:00 2001
From: alexmanev <amanev95@gmail.com>
Date: Thu, 22 Oct 2026 13:04:20 +0000
Subject: [PATCH] Add gamepad mode: expose the Miyoo keypad as a game
 controller

The MMiyoo joystick driver now reports the keypad as an Xbox style
controller while the app has it open (moonlight does this when a stream
starts). Select+X toggles between keyboard and gamepad mode, and the
starting mode, d-pad as left stick and button layout are read from the
"gamepad" block in config/settings.json.
---
 src/cfg/SDL_moonlightcfg_mmiyoo.c         |  32 ++++++
 src/cfg/SDL_moonlightcfg_mmiyoo.h         |  10 ++
 src/joystick/mmiyoo/SDL_joystick_mmiyoo.c | 123 +++++++++++++++++++++-
 src/video/mmiyoo/SDL_event_mmiyoo.c       |  86 ++++++++++++++-
 src/video/mmiyoo/SDL_event_mmiyoo.h       |   3 +
 5 files changed, 247 insertions(+), 7 deletions(-)

diff --git a/src/cfg/SDL_moonlightcfg_mmiyoo.c b/src/cfg/SDL_moonlightcfg_mmiyoo.c
index 521a4a6..01ac541 100644
--- a/src/cfg/SDL_moonlightcfg_mmiyoo.c
+++ b/src/cfg/SDL_moonlightcfg_mmiyoo.c
@@ -58,6 +58,37 @@ int cfgReadMouse(struct json_object *jfile) {
     return 0;
 }
 
+int cfgReadGamepad(struct json_object *jfile) {
+    struct json_object *jval = NULL;
+    struct json_object *jEnabled = NULL;
+    struct json_object *jDpadAsLeftStick = NULL;
+    struct json_object *jUseButtonLabels = NULL;
+
+    moon.gamepad.enabled = MMIYOO_DEFAULT_GAMEPAD_ENABLED;
+    moon.gamepad.dpadAsLeftStick = MMIYOO_DEFAULT_GAMEPAD_DPAD_AS_STICK;
+    moon.gamepad.useButtonLabels = MMIYOO_DEFAULT_GAMEPAD_BUTTON_LABELS;
+
+    json_object_object_get_ex(jfile, "gamepad", &jval);
+    if (!jval) {
+        printf("Gamepad settings not found in json file. Using defaults.\n");
+        return 0;
+    }
+
+    if (json_object_object_get_ex(jval, "enabled", &jEnabled)) {
+        moon.gamepad.enabled = json_object_get_boolean(jEnabled);
+    }
+    if (json_object_object_get_ex(jval, "dpadAsLeftStick", &jDpadAsLeftStick)) {
+        moon.gamepad.dpadAsLeftStick = json_object_get_boolean(jDpadAsLeftStick);
+    }
+    if (json_object_object_get_ex(jval, "useButtonLabels", &jUseButtonLabels)) {
+        moon.gamepad.useButtonLabels = json_object_get_boolean(jUseButtonLabels);
+    }
+
+    printf("[json] Gamepad settings: enabled=%d, dpadAsLeftStick=%d, useButtonLabels=%d\n",
+           moon.gamepad.enabled, moon.gamepad.dpadAsLeftStick, moon.gamepad.useButtonLabels);
+    return 0;
+}
+
 int cfgReadClock(struct json_object *jfile) {
     struct json_object *jval = NULL;
     json_object_object_get_ex(jfile, "cpuclock", &jval);
@@ -210,6 +241,7 @@ int read_moonlight_config(void)
     cfgReadCustomKeys(jfile);
     cfgReadClock(jfile);
     cfgReadMouse(jfile);
+    cfgReadGamepad(jfile);
 
     json_object_put(jfile);
     return 0;
diff --git a/src/cfg/SDL_moonlightcfg_mmiyoo.h b/src/cfg/SDL_moonlightcfg_mmiyoo.h
index 123982f..cb09f65 100644
--- a/src/cfg/SDL_moonlightcfg_mmiyoo.h
+++ b/src/cfg/SDL_moonlightcfg_mmiyoo.h
@@ -30,6 +30,9 @@
 #define MMIYOO_DEFAULT_ACCELERATION 2.0
 #define MMIYOO_DEFAULT_ACCELERATION_RATE 2.5
 #define MMIYOO_DEFAULT_MAX_ACCELERATION 10.0
+#define MMIYOO_DEFAULT_GAMEPAD_ENABLED 0
+#define MMIYOO_DEFAULT_GAMEPAD_DPAD_AS_STICK 0
+#define MMIYOO_DEFAULT_GAMEPAD_BUTTON_LABELS 0
 
 SDL_Keycode stringToKeycode(const char *keyString);
 int read_moonlight_config(void);
@@ -60,11 +63,18 @@ typedef struct _MOUSE {
     float maxAcceleration;
 } MOUSE;
 
+typedef struct _GAMEPAD {
+    int enabled;        // start streams in gamepad mode
+    int dpadAsLeftStick; // dpad drives the left analog stick instead of the dpad
+    int useButtonLabels; // map by label (Miyoo A -> Xbox A) instead of by position
+} GAMEPAD;
+
 typedef struct _MOON {
     int cpuclock;
     char cfg_path[MAX_PATH];
     CUSTKEY customkey;
     MOUSE mouse;
+    GAMEPAD gamepad;
 } MOON;
 
 #endif
